# Backend Environment Variables

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=
# Optional separate at-rest key; if blank it is derived from JWT_SECRET. Keep stable to decrypt saved PINs.
PII_ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Jakarta
AUTO_OFFLINE_TIME=00:00

# OSRM route service (driving). Development defaults to the public demo server;
# production requires a self-hosted OSRM instance or another provider.
OSRM_BASE_URL=

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=servitrack
DB_TEST_NAME=servitrack_test
DB_APP_USER=servitrack_app
DB_APP_PASS=app_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=servitrack

# WhatsApp / OpenWA
OPENWA_BASE_URL=https://openwa.example.invalid
OPENWA_API_KEY=your-openwa-api-key
PUBLIC_APP_URL=http://localhost:5173
QUOTATION_VALIDITY_DAYS=7
ESTIMATED_PART_ARRIVAL_DAYS=7

# Payment Gateway
# Configure Midtrans MAP Payment Notification URL as https://<public-api-host>/api/webhooks/midtrans
# Sandbox Server Key starts with SB-Mid-server-; production starts with Mid-server-.
MIDTRANS_SERVER_KEY=<SB-Mid-server-sandbox-key>
# Client Key starts with Mid-client- in both sandbox and production.
MIDTRANS_CLIENT_KEY=<Mid-client-key>
# Signature Secret Key starts with Mid-server- in both sandbox and production.
MIDTRANS_SIGNATURE_KEY=<Mid-server-signature-secret-key>
MIDTRANS_IS_PRODUCTION=false
