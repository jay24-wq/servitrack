# Backend Environment Variables

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=servitrack
DB_TEST_NAME=servitrack_test
DB_APP_USER=servitrack_app
DB_APP_PASS=app_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=servitrack

# WhatsApp / OpenWA
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-api-key
OPENWA_SESSION=servitrack
PUBLIC_APP_URL=http://localhost:5173

# Payment Gateway
PAYMENT_GATEWAY_URL=https://api.midtrans.com
PAYMENT_GATEWAY_KEY=your-midtrans-key
PAYMENT_GATEWAY_IS_PRODUCTION=false

# Maps
MAPS_API_KEY=your-google-maps-api-key
